<Window x:Class="FAVIS.ToolEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tool Editor"
        Width="1100"
        Height="760"
        MinWidth="850"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        Foreground="White"
        FontFamily="{DynamicResource DefaultFontFamily}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <Button DockPanel.Dock="Right"
                    Content="툴 추가"
                    Width="90"
                    Height="30"
                    Margin="8,0,0,0"
                    Click="AddToolButton_Click"/>
            <ComboBox x:Name="AvailableToolsComboBox"
                      Height="30"
                      DisplayMemberPath="DisplayName"
                      Background="#0A0A0A"
                      Foreground="Black"/>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0">
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,8,0,0">
                    <Button Content="위로" Width="70" Margin="2"
                            Click="MoveUpButton_Click"/>
                    <Button Content="아래로" Width="70" Margin="2"
                            Click="MoveDownButton_Click"/>
                    <Button Content="삭제" Width="70" Margin="2"
                            Click="DeleteToolButton_Click"/>
                </StackPanel>
                <ListBox x:Name="ToolsListBox"
                         SelectionChanged="ToolsListBox_SelectionChanged"
                         Background="#0A0A0A"
                         Foreground="White"
                         BorderBrush="#444444"
                         DisplayMemberPath="DisplayName"/>
            </DockPanel>

            <Border Grid.Column="2"
                    Background="#0A0A0A"
                    BorderBrush="#444444"
                    BorderThickness="1"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ParametersPanel"/>
                </ScrollViewer>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,10,0,0">
            <Button Content="취소" Width="90" Height="32" Margin="4"
                    IsCancel="True"/>
            <Button Content="저장" Width="90" Height="32" Margin="4"
                    IsDefault="True"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
