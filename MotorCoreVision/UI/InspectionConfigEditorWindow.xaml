<Window x:Class="FAVIS.InspectionConfigEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FAVIS"
        Title="Inspection Configuration"
        Width="1600"
        Height="720"
        WindowStartupLocation="CenterOwner"
        Background="#1A1A1A"
        Foreground="White"
        FontFamily="{DynamicResource DefaultFontFamily}">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Inspection Configuration" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>

        <Grid Grid.Row="1" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="170"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="PC Name" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="PcNameTextBox" Grid.Column="1" Height="28" Padding="6,3"
                     Background="#0A0A0A" Foreground="White" BorderBrush="#444444"/>
            <TextBlock Text="Display Count" Grid.Column="2" VerticalAlignment="Center" Margin="20,0,8,0"/>
            <TextBox x:Name="DisplayCountTextBox" Grid.Column="3" Height="28" Padding="6,3"
                     Background="#0A0A0A" Foreground="White" BorderBrush="#444444"
                     TextChanged="DisplayCountTextBox_TextChanged"/>
            <CheckBox x:Name="InspectionPassCheckBox"
                      Grid.Column="4"
                      Content="Inspection Pass"
                      VerticalAlignment="Center"
                      Margin="20,0,0,0"
                      Foreground="White"/>
            <TextBlock Text="Image Saving"
                       Grid.Column="5"
                       VerticalAlignment="Center"
                       Margin="18,0,8,0"/>
            <ComboBox x:Name="ImageSaveModeComboBox"
                      Grid.Column="6"
                      Height="28"
                      SelectedValuePath="Tag"
                      Background="#0A0A0A"
                      Foreground="Black">
                <ComboBoxItem Content="저장 안 함" Tag="{x:Static local:ImageSaveMode.None}"/>
                <ComboBoxItem Content="OK만 저장" Tag="{x:Static local:ImageSaveMode.OkOnly}"/>
                <ComboBoxItem Content="NG만 저장" Tag="{x:Static local:ImageSaveMode.NgOnly}"/>
                <ComboBoxItem Content="모두 저장" Tag="{x:Static local:ImageSaveMode.All}"/>
            </ComboBox>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Image Save Path" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBox x:Name="ImageSavePathTextBox" Grid.Column="1" Height="28" Padding="6,3"
                     Background="#0A0A0A" Foreground="White" BorderBrush="#444444"/>
            <Button Grid.Column="2"
                    Content="..."
                    Width="32"
                    Height="28"
                    Margin="6,0,0,0"
                    Click="BrowseImageSavePathButton_Click"/>
        </Grid>

        <TabControl Grid.Row="3" Background="#1A1A1A" Foreground="White">
            <TabControl.Resources>
                <Style x:Key="ColumnHeaderStyle" TargetType="{x:Type DataGridColumnHeader}">
                    <Setter Property="Background" Value="#3A3A3A"/>
                    <Setter Property="Foreground" Value="#CCFF00"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,5"/>
                    <Setter Property="BorderBrush" Value="#555555"/>
                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                </Style>
                <Style x:Key="CenteredColumnHeaderStyle"
                       TargetType="{x:Type DataGridColumnHeader}"
                       BasedOn="{StaticResource ColumnHeaderStyle}">
                    <Setter Property="HorizontalContentAlignment" Value="Center"/>
                </Style>
                <Style x:Key="CenteredTextStyle" TargetType="{x:Type TextBlock}">
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                    <Setter Property="TextAlignment" Value="Center"/>
                </Style>
            </TabControl.Resources>

            <TabItem Header="Sequences">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="SequenceGrid"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      IsReadOnly="False"
                      Background="#0A0A0A"
                      Foreground="White"
                      RowBackground="#1A1A1A"
                      AlternatingRowBackground="#242424"
                      BorderBrush="#444444"
                      GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                    <DataGridCheckBoxColumn Header="Enabled"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Binding="{Binding Enabled, UpdateSourceTrigger=PropertyChanged}"
                                            Width="75">
                        <DataGridCheckBoxColumn.ElementStyle>
                            <Style TargetType="{x:Type CheckBox}">
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridCheckBoxColumn.ElementStyle>
                    </DataGridCheckBoxColumn>
                    <DataGridTemplateColumn Header="Output Type"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding OutputTypeOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedItem="{Binding OutputType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Sequence Name"
                                        HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                        Width="220"/>
                    <DataGridTemplateColumn Header="Path"
                                            HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                            Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Margin="2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="34"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="SequencePathTextBox"
                                             Text="{Binding Path, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             TextChanged="SequencePathTextBox_TextChanged"
                                             Background="#0A0A0A"
                                             Foreground="White"
                                             BorderBrush="#444444"
                                             Padding="4,2"/>
                                    <Popup x:Name="PathTokenPopup"
                                           PlacementTarget="{Binding ElementName=SequencePathTextBox}"
                                           Placement="Bottom"
                                           StaysOpen="False"
                                           AllowsTransparency="True"
                                           PopupAnimation="Fade">
                                        <Border Background="#1A1A1A"
                                                BorderBrush="#555555"
                                                BorderThickness="1">
                                            <ListBox Tag="{Binding ElementName=SequencePathTextBox}"
                                                     SelectionChanged="PathTokenListBox_SelectionChanged"
                                                     Background="#1A1A1A"
                                                     Foreground="White"
                                                     Padding="2">
                                                <ListBoxItem Content="{}{Default}"/>
                                                <ListBoxItem Content="{}{ModelDir}"/>
                                                <ListBoxItem Content="{}{ModelNo}"/>
                                                <ListBoxItem Content="{}{ModelName}"/>
                                                <ListBoxItem Content="{}{StepNo}"/>
                                                <ListBoxItem Content="{}{StepName}"/>
                                                <ListBoxItem Content="{}{WorkDir}"/>
                                            </ListBox>
                                        </Border>
                                    </Popup>
                                    <Button Grid.Column="1"
                                            Content="..."
                                            Margin="3,0,0,0"
                                            Tag="{Binding}"
                                            Click="EditSequencePathButton_Click"/>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Grabber"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding CameraIdOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedItem="{Binding CameraIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Trigger Step"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox SelectedValue="{Binding TriggerStep, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          SelectedValuePath="Content"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Margin="4,2">
                                    <ComboBoxItem Content="1"/>
                                    <ComboBoxItem Content="2"/>
                                    <ComboBoxItem Content="3"/>
                                    <ComboBoxItem Content="4"/>
                                    <ComboBoxItem Content="5"/>
                                    <ComboBoxItem Content="6"/>
                                    <ComboBoxItem Content="7"/>
                                    <ComboBoxItem Content="8"/>
                                    <ComboBoxItem Content="9"/>
                                    <ComboBoxItem Content="10"/>
                                </ComboBox>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Display"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding DisplayIndexOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedItem="{Binding DisplayIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="External Light"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Width="130">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ComboBox ItemsSource="{Binding LightIndexOptions, RelativeSource={RelativeSource AncestorType={x:Type Window}}}"
                                          SelectedValuePath="Index"
                                          SelectedValue="{Binding ExternalLightIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          DisplayMemberPath="DisplayName"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Margin="4,2"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Light Brightness (%)"
                                            HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                            Width="145">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding ExternalLightBrightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Margin="4,2"
                                         Padding="3,1"
                                         Background="#0A0A0A"
                                         Foreground="White"
                                         BorderBrush="#444444"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add" Width="80" Height="30" Margin="0,0,8,0" Click="AddButton_Click"/>
                        <Button Content="Delete" Width="80" Height="30" Margin="0,0,8,0" Click="DeleteButton_Click"/>
                        <Button Content="Move Up" Width="80" Height="30" Margin="0,0,8,0" Click="MoveUpButton_Click"/>
                        <Button Content="Move Down" Width="90" Height="30" Click="MoveDownButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Grabbers">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid x:Name="CameraGrid"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              Background="#0A0A0A"
                              Foreground="White"
                              RowBackground="#1A1A1A"
                              AlternatingRowBackground="#242424"
                              BorderBrush="#444444"
                              GridLinesVisibility="Horizontal"
                              CellEditEnding="CameraGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Binding="{Binding Id, UpdateSourceTrigger=PropertyChanged}"
                                                Width="80"/>
                            <DataGridTextColumn Header="Type"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Binding="{Binding Type}"
                                                IsReadOnly="True"
                                                Width="110"/>
                            <DataGridTextColumn Header="Name"
                                                HeaderStyle="{StaticResource ColumnHeaderStyle}"
                                                Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                Width="*"/>
                            <DataGridTextColumn Header="IP"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Binding="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}"
                                                Width="180"/>
                            <DataGridTextColumn Header="Port"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Binding="{Binding Port, UpdateSourceTrigger=PropertyChanged}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Sensor Index"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Binding="{Binding SensorIndex, UpdateSourceTrigger=PropertyChanged}"
                                                Width="110"/>
                            <DataGridTextColumn Header="Pattern Index"
                                                HeaderStyle="{StaticResource CenteredColumnHeaderStyle}"
                                                ElementStyle="{StaticResource CenteredTextStyle}"
                                                Binding="{Binding PatternIndex, UpdateSourceTrigger=PropertyChanged}"
                                                Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Add Deediim" Width="110" Height="30" Margin="0,0,8,0" Click="AddCameraButton_Click"/>
                        <Button Content="Add HikCamera" Width="120" Height="30" Margin="0,0,8,0" Click="AddHikCameraButton_Click"/>
                        <Button Content="Delete" Width="80" Height="30" Click="DeleteCameraButton_Click"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="PLC">
                <Grid Margin="16">
                    <Grid.Resources>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="White"/>
                        </Style>
                    </Grid.Resources>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="260"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="PLC Type" Grid.Row="0" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <ComboBox x:Name="PlcTypeComboBox" Grid.Row="0" Grid.Column="1" Height="28"
                              Margin="0,0,0,8" Background="#0A0A0A" Foreground="Black">
                        <ComboBoxItem Content="LS"/>
                    </ComboBox>
                    <TextBlock Text="PLC IP Address" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcIpAddressTextBox" Grid.Row="1" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="PLC Port" Grid.Row="2" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcPortTextBox" Grid.Row="2" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="Station Number" Grid.Row="3" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcStationNumberTextBox" Grid.Row="3" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="Scan Time (ms)" Grid.Row="4" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcScanTimeTextBox" Grid.Row="4" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="PLC Address" Grid.Row="5" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcAddressTextBox" Grid.Row="5" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="PC Address" Grid.Row="6" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PcAddressTextBox" Grid.Row="6" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="Reject Address" Grid.Row="7" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="RejectAddressTextBox" Grid.Row="7" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="Model No Address" Grid.Row="8" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcModelNoAddressTextBox" Grid.Row="8" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="Step No Address" Grid.Row="9" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcStepNoAddressTextBox" Grid.Row="9" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                    <TextBlock Text="Serial No Address" Grid.Row="10" VerticalAlignment="Center" Margin="0,0,8,8"/>
                    <TextBox x:Name="PlcSerialNoAddressTextBox" Grid.Row="10" Grid.Column="1" Height="28"
                             Padding="6,3" Margin="0,0,0,8" Background="#0A0A0A"
                             Foreground="White" BorderBrush="#444444"/>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Save" Width="80" Height="30" Margin="0,0,8,0" Click="SaveButton_Click"/>
            <Button Content="Cancel" Width="80" Height="30" Click="CancelButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
