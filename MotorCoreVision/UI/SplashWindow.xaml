<Window x:Class="FAVIS.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520"
        Height="250"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="NoResize"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#151515"
        FontFamily="{DynamicResource DefaultFontFamily}">
    <Border BorderBrush="#444444" BorderThickness="1" Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="MotorCoreVision" FontSize="25"
                           Foreground="#CCFF00" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="Inspection System" FontSize="14"
                           Foreground="#AAAAAA" Margin="0,8,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
            <ProgressBar x:Name="LoadingProgressBar" Grid.Row="1" Height="8"
                         Minimum="0" Maximum="100" Value="0"
                         Background="#333333" Foreground="#CCFF00"/>
            <TextBlock x:Name="LoadingText" Grid.Row="2" Text="Loading..."
                       Foreground="White" FontSize="11" Margin="0,10,0,0"
                       HorizontalAlignment="Center"/>
        </Grid>
    </Border>
</Window>
